<template>
  <div class="home">
    <header class="hero">
      <h1 class="name">{{ config.name }}<span class="caret" aria-hidden="true"></span></h1>
      <p class="role">{{ config.title }}</p>
      <p class="bio">{{ config.bio }}</p>
    </header>

    <nav class="home-grid" :aria-label="copy.landing.navLabel">
      <a
        u-for="card in visibleCards"
        :href="card.url"
        :class="'home-tile ' + card.span"
        :style="'--accent:' + card.accent"
        :target="card.external ? '_blank' : undefined"
        :rel="card.external ? 'noopener noreferrer' : undefined"
      >
        <div class="tile-head">
          <span class="t-kind" aria-hidden="true">{{ card.kind }}</span>
          <span
            :class="card.url.charAt(0) === '/' ? 'tile-arrow internal' : 'tile-arrow external'"
            aria-hidden="true"
          >{{ card.url.charAt(0) === '/' ? '→' : '↗' }}</span>
        </div>

        <div class="t-bignum" u-if="card.live === 'repos' && repoCount()" aria-hidden="true">
          <span class="t-bignum-n">{{ repoCount() }}</span>
          <span class="t-bignum-l"><i class="dot"></i>{{ copy.landing.repoCountLabel }}</span>
        </div>

        <div class="tile-body">
          <h2 class="t-name">{{ card.title }}</h2>
          <p class="t-desc">{{ card.description }}</p>
        </div>
      </a>
    </nav>

    <footer class="contact">
      <div class="contact-links">
        <a :href="'mailto:' + config.contact.email" class="social-link">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"/><path d="M3 7l9 6l9 -6"/></svg>
          {{ copy.landing.emailLink }}
        </a>
        <a :href="config.contact.github" target="_blank" rel="noopener noreferrer" class="social-link">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"/></svg>
          {{ copy.landing.githubLink }}
        </a>
        <a :href="config.contact.linkedin" target="_blank" rel="noopener noreferrer" class="social-link">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 11v5"/><path d="M8 8v.01"/><path d="M12 16v-5"/><path d="M16 16v-3a2 2 0 1 0 -4 0"/><path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10"/></svg>
          {{ copy.landing.linkedinLink }}
        </a>
      </div>
      <p class="contact-legal" style="margin: 1.25rem 0 0;"><a href="/privacy" style="color: var(--text-faint); font-size: 0.8rem; text-decoration: none;">{{ copy.landing.privacyLink }}</a></p>
    </footer>
  </div>
</template>

<script>
import { computed } from '@matthesketh/utopia-core'
import { config } from '../../site.config'
import { repoIndex } from '../lib/store'
import { copy } from '../lib/copy'

const repoCount = computed(
  () => Object.values(repoIndex()).filter((r) => !r.fork && !r.archived).length,
)

// Hide a nav card whose section isn't configured, so dropping `openSource` or
// `apps` from the config never leaves a dead internal link on the home page.
const visibleCards = config.navCards.filter((c) => {
  if (c.url === '/open-source') return !!config.openSource
  if (c.url === '/apps') return !!(config.apps && Array.isArray(config.apps.items) && config.apps.items.length > 0)
  return true
})
</script>

<style scoped>
.home {
  max-width: 880px;
  margin: 0 auto;
  padding: 5.5rem 2rem;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  gap: 2.75rem;
}

/* --- hero --- */
.hero {
  animation: rise 0.55s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
}
.name {
  font-family: var(--font-heading);
  font-size: clamp(2.2rem, 6vw, 3.4rem);
  font-weight: 800;
  letter-spacing: -1.5px;
  line-height: 1.08;
  margin: 0;
  color: var(--text);
  display: inline-flex;
  align-items: center;
}
.caret {
  display: inline-block;
  width: 0.5ch;
  height: 0.82em;
  background: var(--accent, #6b7cff);
  margin-left: 0.18em;
  animation: caret-blink 1.1s step-end infinite;
}
.role {
  font-size: 1.2rem;
  font-weight: 500;
  margin: 0.5rem 0 0;
  color: var(--text);
}
.bio {
  font-size: 1.05rem;
  line-height: 1.75;
  color: var(--text-muted);
  margin: 1.1rem 0 0;
  max-width: 60ch;
}

/* --- bento --- */
.home-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-auto-rows: 150px;
  grid-auto-flow: dense;
  gap: 14px;
}

.home-tile {
  --accent: var(--text);
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 1.3rem;
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--border);
  text-decoration: none;
  overflow: hidden;
  animation: rise 0.55s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
  transition: transform 0.18s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.18s ease;
}
.home-tile::before {
  content: '';
  position: absolute;
  inset: 0 auto 0 0;
  width: 4px;
  background: var(--accent);
  transform: scaleY(0);
  transform-origin: bottom;
  transition: transform 0.22s ease;
}
.home-tile:hover {
  transform: translateY(-4px);
  box-shadow: 7px 7px 0 0 var(--accent);
}
.home-tile:hover::before { transform: scaleY(1); }
.home-tile:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}

.home-tile:nth-child(1) { animation-delay: 0.08s; }
.home-tile:nth-child(2) { animation-delay: 0.13s; }
.home-tile:nth-child(3) { animation-delay: 0.18s; }
.home-tile:nth-child(4) { animation-delay: 0.23s; }
.home-tile:nth-child(5) { animation-delay: 0.28s; }

.home-tile.lg   { grid-column: span 2; grid-row: span 2; }
.home-tile.wide { grid-column: span 2; }
.home-tile.sm   { grid-column: span 1; }

.tile-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.5rem;
}
.t-kind {
  font-size: 0.66rem;
  text-transform: uppercase;
  letter-spacing: 2px;
  font-weight: 700;
  color: var(--accent);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.tile-arrow {
  font-size: 1.1rem;
  line-height: 1;
  color: var(--accent);
  flex: none;
  transition: transform 0.2s ease;
}
.home-tile:hover .tile-arrow.internal { transform: translateX(4px); }
.home-tile:hover .tile-arrow.external { transform: translate(3px, -3px); }

.tile-body { margin-top: auto; }
.t-name {
  font-family: var(--font-heading);
  font-size: 1.15rem;
  font-weight: 700;
  letter-spacing: -0.3px;
  margin: 0;
  color: var(--text);
  word-break: break-word;
}
.home-tile.lg .t-name { font-size: 1.75rem; letter-spacing: -0.6px; }
.t-desc {
  font-size: 0.85rem;
  line-height: 1.45;
  color: var(--text-muted);
  margin: 0.3rem 0 0;
}
/* flagship live stat — fills the large tile, ties to the showcase posters */
.t-bignum {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
}
.t-bignum-n {
  font-family: var(--font-heading);
  font-size: 3rem;
  font-weight: 800;
  line-height: 0.9;
  letter-spacing: -2px;
  color: var(--accent);
}
.t-bignum-l {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  line-height: 1;
  color: var(--accent);
}
.t-bignum-l .dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--accent);
  display: block;
  animation: pulse 2s ease-in-out infinite;
}

/* --- contact --- */
.contact {
  margin-top: 0.5rem;
  animation: rise 0.55s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
  animation-delay: 0.34s;
}
.contact-links {
  display: flex;
  gap: 2rem;
  flex-wrap: wrap;
}
.social-link {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  color: var(--text);
  text-decoration: none;
  font-weight: 600;
  border-bottom: 1px solid transparent;
  transition: border-color 0.15s ease;
}
.social-link:hover { border-color: var(--border); }

/* --- keyframes --- */
@keyframes caret-blink { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }
@keyframes rise {
  from { opacity: 0; transform: translateY(14px); }
  to   { opacity: 1; transform: none; }
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

/* --- responsive --- */
@media (max-width: 720px) {
  .home { padding: 4rem 1.5rem; gap: 2.25rem; }
  .home-grid { grid-template-columns: repeat(2, 1fr); }
  .home-tile.lg   { grid-column: span 2; grid-row: span 2; }
  .home-tile.wide { grid-column: span 2; }
}

@media (max-width: 480px) {
  .home { padding: 3rem 1.15rem; }
  .home-grid { grid-auto-rows: 140px; gap: 10px; }
  .home-tile { padding: 1.05rem; }
  /* stays a 2-col bento: flagship is a full square, GitHub a full-width finish */
  .home-tile.lg { grid-column: span 2; grid-row: span 2; }
  .home-tile.lg .t-name { font-size: 1.5rem; }
  .home-tile.sm:last-child { grid-column: span 2; }
  .t-bignum-n { font-size: 2.6rem; }
  .contact-links { gap: 1.25rem; }
}

@media (prefers-reduced-motion: reduce) {
  .hero, .home-tile, .contact { animation: none; }
  .home-tile:hover { transform: none; }
  .caret, .t-bignum-l .dot { animation: none; }
  .tile-arrow { transition: none; }
}
</style>
